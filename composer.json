            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "objectdetector",
        "object detection api",
        "object detector api",
        "detect objects in image api",
        "image object recognition api",
        "coco object detection"
    ],
    "homepage": "https://apiverve.com/marketplace/objectdetector?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/objectdetector",
        "source": "https://github.com/apiverve/objectdetector-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
